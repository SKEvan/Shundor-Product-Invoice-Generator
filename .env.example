# Copy this file to `.env.local` and fill in the values from
# Supabase Dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# The login screen asks for a username. Behind the scenes Supabase needs an
# email, so "admin" becomes "admin@<this domain>". No email is ever sent.
VITE_AUTH_EMAIL_DOMAIN=shundorproduct.app
